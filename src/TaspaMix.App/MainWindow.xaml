<Window x:Class="TaspaMix.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="taspaMIX Ultimate" Icon="/Assets/taspaMIX-logo.png" Height="960" Width="1600" MinHeight="760" MinWidth="1180" Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}" WindowStartupLocation="CenterScreen">
 <Grid Margin="6">
  <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/><RowDefinition Height="88"/></Grid.RowDefinitions>
  <Border Background="#071A29" BorderBrush="#16465B" BorderThickness="1" CornerRadius="10" Padding="14">
   <DockPanel LastChildFill="True">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Image Source="/Assets/taspaMIX-logo.png" Width="66" Height="52" Stretch="Uniform" Margin="0,0,8,0" ToolTip="Оригинальный логотип taspaMIX"/>
     <StackPanel Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock FontSize="30" FontWeight="Bold"><Run Text="taspa" Foreground="#F5F7FA"/><Run Text="MIX" Foreground="{StaticResource GoldBrush}"/></TextBlock><TextBlock Text="АУДИО  •  ВИДЕО  •  КОНТЕНТ  •  ВАШИ СОБЫТИЯ" FontSize="10" Foreground="#8DB1C5"/></StackPanel>
    </StackPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><StackPanel Margin="10,0" VerticalAlignment="Center"><TextBlock Text="taspaMIX • LIVE" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="Пульт управления" FontSize="10" Foreground="{StaticResource MutedBrush}"/></StackPanel><Button Content="⚙ Настройки"/><Button Content="⛶ Полный экран" Click="Fullscreen_Click"/></StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Row="1" Margin="0,10">
   <Grid.ColumnDefinitions><ColumnDefinition Width="176"/><ColumnDefinition Width="1.48*"/><ColumnDefinition Width="1.35*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="#153C50" BorderThickness="1" CornerRadius="9" Padding="8" Margin="0,0,8,0">
    <DockPanel><StackPanel DockPanel.Dock="Bottom" Margin="4,8"><TextBlock Text="taspaMIX" Foreground="#5D8FA8" FontSize="20" FontWeight="Bold"/><TextBlock Text="ULTIMATE • v1.0" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel><StackPanel><TextBlock Text="РАЗДЕЛЫ" Foreground="{StaticResource MutedBrush}" Margin="8,8,4,10" FontSize="10"/>
     <Button Content="♫   Музыка" Click="Section_Click" Tag="Музыка" Height="44" HorizontalContentAlignment="Left"/><Button Content="▣   Видео" Click="Section_Click" Tag="Видео" Height="44" HorizontalContentAlignment="Left"/><Button Content="🏆   Конкурсы" Click="Section_Click" Tag="Конкурсы" Height="44" HorizontalContentAlignment="Left"/><Button Content="ϟ   Тычки" Click="Section_Click" Tag="Тычки" Height="44" HorizontalContentAlignment="Left"/><Button Content="☷   Плейлисты" Click="Section_Click" Tag="Плейлисты" Height="44" HorizontalContentAlignment="Left"/><Button Content="✧   Эффекты" Click="Section_Click" Tag="Эффекты" Height="44" HorizontalContentAlignment="Left"/><Button Content="▣   Экран / Сцены" Click="Section_Click" Tag="Сцены" Height="44" HorizontalContentAlignment="Left"/><Button Content="▣   Вывод" Click="DetectDisplays_Click" Height="44" HorizontalContentAlignment="Left"/><Button Content="⚙   Настройки" Height="44" HorizontalContentAlignment="Left"/>
    </StackPanel></DockPanel>
   </Border>
   <Grid Grid.Column="1" Margin="0,0,8,0">
    <Grid.RowDefinitions><RowDefinition Height="1.3*"/><RowDefinition Height="0.9*"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="#153C50" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,0,8">
     <DockPanel><StackPanel DockPanel.Dock="Top"><DockPanel><TextBlock x:Name="SectionTitle" Text="Музыка" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/><Button DockPanel.Dock="Right" Content="＋ Добавить папку" Click="AddFolder_Click"/></DockPanel><TextBlock x:Name="LibraryStatus" Text="Импортируй свою медиатеку" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,6"/><DockPanel><TextBox x:Name="SearchBox" Height="34" Padding="9" Margin="2" Background="#071521" Foreground="{StaticResource TextBrush}" BorderBrush="#1A5066" TextChanged="SearchBox_TextChanged"/><Button Content="⟳" Width="44" Click="Refresh_Click"/></DockPanel></StackPanel>
     <DataGrid x:Name="MediaGrid" Margin="0,8,0,0" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" MouseDoubleClick="MediaGrid_DoubleClick" Background="#071521" Foreground="{StaticResource TextBrush}" RowBackground="#0A1A27" AlternatingRowBackground="#0D2231" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#16364A" HeadersVisibility="Column" BorderThickness="0"><DataGrid.Columns><DataGridTemplateColumn Header="Тип" Width="48"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="♫"/><Setter Property="FontSize" Value="17"/><Style.Triggers><DataTrigger Binding="{Binding Kind}" Value="Видео"><Setter Property="Text" Value="🎬"/><Setter Property="FontSize" Value="15"/></DataTrigger></Style.Triggers></Style></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="Плейлист / папка" Binding="{Binding Playlist}" Width="1.2*"/><DataGridTextColumn Header="Тип" Binding="{Binding Kind}" Width="70"/><DataGridTextColumn Header="Путь к файлу" Binding="{Binding Path}" Width="2*"/></DataGrid.Columns></DataGrid></DockPanel>
    </Border>
    <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="#153C50" BorderThickness="1" CornerRadius="9" Padding="12">
     <DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="♫  СЕЙЧАС ИГРАЕТ" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/><TextBlock x:Name="NowPlaying" Text="Ничего не воспроизводится" FontSize="16" Margin="0,8,0,3"/><TextBlock Text="Локальный аудиоплеер" Foreground="{StaticResource MutedBrush}" FontSize="11"/></StackPanel><StackPanel DockPanel.Dock="Bottom"><ProgressBar Height="5" Value="18" Foreground="{StaticResource AccentBrush}" Background="#19384B" Margin="0,10"/><DockPanel><StackPanel Orientation="Horizontal"><Button Content="＋ В плейлист" Click="AddToPlaylist_Click"/><Button Content="✂ Обрезать"/><Button Content="☆ Избранное"/></StackPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="▶ Play" Click="Play_Click"/><Button Content="Ⅱ Pause" Click="Pause_Click"/><Button Content="■ Stop" Click="Stop_Click"/><Button Content="VOCAL" Click="Vocal_Click"/><Button Content="ПУСК" Click="Start_Click"/></StackPanel></DockPanel></StackPanel><Border Background="#071521" CornerRadius="6" Margin="0,8" Padding="6"><TextBlock Text="▂▅▃▇▆▂▅▇▃▅▆▇▂▅▃▇▆▃▅▇▂▅▆▃▇▅▂▆▇▃▅▂▇▆▃▅▇" Foreground="{StaticResource AccentBrush}" FontSize="20" HorizontalAlignment="Center"/></Border></DockPanel>
    </Border>
   </Grid>
   <Grid Grid.Column="2">
    <Grid.RowDefinitions><RowDefinition Height="1.12*"/><RowDefinition Height="0.72*"/><RowDefinition Height="0.92*"/></Grid.RowDefinitions>
    <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="#15546A" BorderThickness="1" CornerRadius="9" Padding="8" Margin="0,0,4,8"><DockPanel><TextBlock DockPanel.Dock="Top" Text="▣  Предпросмотр (Preview)" FontWeight="Bold" Margin="4,3,4,8"/><Border Background="#06111A" CornerRadius="6" BorderBrush="#12384C" BorderThickness="1"><MediaElement x:Name="PreviewPlayer" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform" MediaFailed="PreviewPlayer_MediaFailed"/></Border><TextBlock DockPanel.Dock="Bottom" Text="Источник: не выбран" Foreground="{StaticResource MutedBrush}" Margin="4,8,4,0" FontSize="10"/></DockPanel></Border>
     <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="#15546A" BorderThickness="1" CornerRadius="9" Padding="8" Margin="4,0,0,8"><DockPanel><TextBlock DockPanel.Dock="Top" Text="✹  На экран (Program)" FontWeight="Bold" Margin="4,3,4,8"/><Border Background="#06111A" CornerRadius="6" BorderBrush="#12384C" BorderThickness="1"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="PROGRAM" Foreground="{StaticResource GoldBrush}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="Нет активного вывода" Foreground="{StaticResource MutedBrush}" Margin="4"/></StackPanel></Border><TextBlock DockPanel.Dock="Bottom" Text="Выход: экран не выбран" Foreground="{StaticResource MutedBrush}" Margin="4,8,4,0" FontSize="10"/></DockPanel></Border>
    </Grid>
    <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="#153C50" BorderThickness="1" CornerRadius="9" Padding="10" Margin="0,0,0,8"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="ПЕРЕХОД И УПРАВЛЕНИЕ ВЫВОДОМ" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" FontSize="10"/><DockPanel Margin="0,8"><ComboBox x:Name="TransitionBox" SelectedIndex="1" Height="34" Width="125"><ComboBoxItem Content="Cut"/><ComboBoxItem Content="Fade"/><ComboBoxItem Content="Dissolve"/></ComboBox><Slider x:Name="TransitionDuration" Minimum="0" Maximum="3" Value="1" Width="120" Margin="8,0" VerticalAlignment="Center"/><Button Content="НА ЭКРАН ▶" Background="#D92539" Foreground="White" FontWeight="Bold" Click="Program_Click"/><Button Content="⏮" Click="PowerPointPrevious_Click"/><Button Content="⏭" Click="PowerPointNext_Click"/></DockPanel></StackPanel><TextBlock Text="БЫСТРЫЕ СЦЕНЫ" FontWeight="Bold" Margin="0,5,0,0"/><UniformGrid Columns="3" Rows="1"><Button Content="Логотип" Click="Scene_Click" Tag="Логотип"/><Button Content="Фон сцены" Click="Scene_Click" Tag="Фон сцены"/><Button Content="Заголовок" Click="Scene_Click" Tag="Заголовок"/></UniformGrid></DockPanel></Border>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
     <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="#153C50" BorderThickness="1" CornerRadius="9" Padding="10" Margin="0,0,4,0"><DockPanel><TextBlock DockPanel.Dock="Top" Text="▣  ВИДЕОТЕКА" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6"/><StackPanel DockPanel.Dock="Bottom"><Button Content="＋ Импорт видео" Click="AddFolder_Click"/><Button Content="🎞 В Preview" Click="Preview_Click"/><Button Content="🔇 Звук видео: ON" Click="ToggleVideoAudio_Click"/></StackPanel><TextBlock Text="Видео будут отображаться отдельно от аудио после импорта папки." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel></Border>
     <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="#153C50" BorderThickness="1" CornerRadius="9" Padding="10" Margin="4,0,0,0"><DockPanel><TextBlock DockPanel.Dock="Top" Text="⚡  ТЫЧКИ" FontWeight="Bold" Foreground="{StaticResource GoldBrush}" Margin="0,0,0,6"/><UniformGrid Columns="2"><Button Content="＋ Слот 1" Tag="1" Click="SoundSlot_Click"/><Button Content="＋ Слот 2" Tag="2" Click="SoundSlot_Click"/><Button Content="＋ Слот 3" Tag="3" Click="SoundSlot_Click"/><Button Content="＋ Слот 4" Tag="4" Click="SoundSlot_Click"/><Button Content="＋ Слот 5" Tag="5" Click="SoundSlot_Click"/><Button Content="＋ Слот 6" Tag="6" Click="SoundSlot_Click"/></UniformGrid><TextBlock Text="Слоты эффектов будут настраиваемыми." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="10"/></DockPanel></Border>
    </Grid>
   </Grid>
  </Grid>
  <Border Grid.Row="2" Background="#081C2A" BorderBrush="#16465B" BorderThickness="1" CornerRadius="9" Padding="10"><DockPanel><StackPanel DockPanel.Dock="Left"><TextBlock Text="ЭФФЕКТЫ И ОВЕРЛЕИ" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="2"/><StackPanel Orientation="Horizontal"><Button Content="T  Текст"/><Button Content="✦ Лого" Click="LogoOverlay_Click"/><Button Content="Таймер 00:00"/><Button Content="▱ Рамка"/><Button Content="Часы"/><Button Content="Анимация"/><Button Content="Lower Third"/><Button Content="Эквалайзер"/></StackPanel></StackPanel><StackPanel DockPanel.Dock="Right" VerticalAlignment="Center"><TextBlock Text="ВЫВОД НА ЭКРАНЫ" Foreground="{StaticResource MutedBrush}" FontSize="10"/><StackPanel Orientation="Horizontal"><Button Content="▣ Основной экран" Click="DetectDisplays_Click"/><Button Content="▣ Доп. экран" Click="DetectDisplays_Click"/></StackPanel><TextBlock x:Name="DisplayStatus" Text="ЭКРАН: не проверен" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel></DockPanel></Border>
 </Grid>
</Window>