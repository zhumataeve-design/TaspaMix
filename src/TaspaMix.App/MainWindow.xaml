<Window x:Class="TaspaMix.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="taspaMIX Ultimate" Height="760" Width="1280" MinHeight="620" MinWidth="980" Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}" WindowStartupLocation="CenterScreen">
 <Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="*"/><RowDefinition Height="70"/></Grid.RowDefinitions>
  <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="16"><DockPanel><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="42" Height="42" Background="#174A58" CornerRadius="9"><TextBlock Text="T" Foreground="{StaticResource GoldBrush}" FontSize="27" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="taspaMIX" FontSize="22" FontWeight="Bold"/><TextBlock Text="ULTIMATE • EVENT CONTROL" FontSize="10" Foreground="{StaticResource MutedBrush}"/></StackPanel></StackPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center"><TextBlock x:Name="DisplayStatus" Text="ЭКРАН: не проверен" VerticalAlignment="Center" Margin="8"/><Button Content="Обнаружить экраны" Click="DetectDisplays_Click"/></StackPanel></DockPanel></Border>
  <Grid Grid.Row="1" Margin="0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="10"><StackPanel><TextBlock Text="РАЗДЕЛЫ" Foreground="{StaticResource MutedBrush}" Margin="8"/><Button Content="♫  Музыка" Click="Section_Click" Tag="Музыка"/><Button Content="▣  Видео" Click="Section_Click" Tag="Видео"/><Button Content="⚡  Тычки" Click="Section_Click" Tag="Тычки"/><Button Content="🏆  Конкурсы" Click="Section_Click" Tag="Конкурсы"/><Button Content="▤  Плейлисты" Click="Section_Click" Tag="Плейлисты"/><Button Content="◈  Сцены" Click="Section_Click" Tag="Сцены"/></StackPanel></Border>
   <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="14" Margin="12,0"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock x:Name="SectionTitle" Text="Медиатека" FontSize="22" FontWeight="Bold"/><TextBlock x:Name="LibraryStatus" Text="Добавь папку с локальными файлами" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,12"/><StackPanel Orientation="Horizontal"><Button Content="＋ Добавить папку" Click="AddFolder_Click"/><Button Content="Обновить поиск" Click="Refresh_Click"/></StackPanel><TextBox x:Name="SearchBox" Height="34" Padding="8" Margin="3,8" Background="#0B1118" Foreground="{StaticResource TextBrush}" BorderBrush="#2A3B49" TextChanged="SearchBox_TextChanged"/></StackPanel><DataGrid x:Name="MediaGrid" AutoGenerateColumns="False" IsReadOnly="True" Background="#0B1118" Foreground="{StaticResource TextBrush}" GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderThickness="0"><DataGrid.Columns><DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="Тип" Binding="{Binding Kind}" Width="90"/><DataGridTextColumn Header="Путь" Binding="{Binding Path}" Width="3*"/></DataGrid.Columns></DataGrid></DockPanel></Border>
   <StackPanel Grid.Column="2"><Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="12" Margin="0,0,0,12"><StackPanel><TextBlock Text="PROGRAM / ВЫХОД" FontWeight="Bold" FontSize="15"/><Border Background="#05090D" Height="150" CornerRadius="8" Margin="0,10"><TextBlock Text="PROGRAM\nНет активного вывода" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/></Border><TextBlock Text="HDMI-вывод будет подключён отдельным этапом" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="11"/></StackPanel></Border><Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="12"><StackPanel><TextBlock Text="БЫСТРЫЕ ЗВУКИ" FontWeight="Bold"/><UniformGrid Columns="2"><Button Content="👏 Аплодисменты" Click="Placeholder_Click"/><Button Content="🎺 Фанфара" Click="Placeholder_Click"/><Button Content="😂 Смех" Click="Placeholder_Click"/><Button Content="🔔 Сигнал" Click="Placeholder_Click"/></UniformGrid><TextBlock Text="Звуковые слоты появятся после подключения аудиодвижка." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="4,8"/></StackPanel></Border></StackPanel>
  </Grid>
  <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="12"><DockPanel><TextBlock x:Name="NowPlaying" Text="Ничего не воспроизводится" VerticalAlignment="Center"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="▶ Play" Click="Play_Click"/><Button Content="Ⅱ Pause" Click="Pause_Click"/><Button Content="■ Stop" Click="Stop_Click"/></StackPanel></DockPanel></Border>
 </Grid>
</Window>
